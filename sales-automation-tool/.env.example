# ===========================================
# 営業自動化ツール 環境変数設定
# ===========================================
# このファイルを .env にコピーして、各値を設定してください
# cp .env.example .env

# Claude API キー
# https://console.anthropic.com/ から取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail API 設定
# Google Cloud Console から credentials.json をダウンロードして
# プロジェクトルートに配置してください
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# 送信者情報
SENDER_NAME=あなたの名前
SENDER_COMPANY=あなたの会社名
SENDER_EMAIL=your-email@example.com

# スクレイピング設定
SCRAPING_TIMEOUT=30000
SCRAPING_HEADLESS=true

# メール設定
EMAIL_SUBJECT_PREFIX=[ご提案]

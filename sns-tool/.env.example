# ============================================
# SNS自動投稿ツール - 環境変数テンプレート
# ============================================
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
# ※ .env.local はGitHubにアップロードされません

# Database (Vercel Postgres)
# Vercelダッシュボード → Storage → Create → Postgres で作成後、接続文字列を設定
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# X (Twitter) API - Free tier
# https://developer.twitter.com/ で取得
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Threads (Meta) API
# https://developers.facebook.com/ で取得
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Claude API (リライト用)
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=

# Gemini API (Nano banana 画像生成用)
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=

# Cron Secret (Vercelの予約投稿用)
# ランダムな文字列を設定してください
CRON_SECRET=
